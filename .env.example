# Base de datos local (docker compose)
MYSQL_DATABASE=mancomunidad
MYSQL_USER=mancomunidad
MYSQL_PASSWORD=mancomunidad
MYSQL_ROOT_PASSWORD=root
MYSQL_PORT=3306

# Backend
APP_DB_URL=jdbc:mysql://localhost:3306/mancomunidad?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
APP_DB_USER=mancomunidad
APP_DB_PASSWORD=mancomunidad
